<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>File Sharing App</title>

  <!-- TailwindCSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- GSAP for animations -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    body {
      background: radial-gradient(circle at top, #ff7e5f, #62109f 40%, #120224 90%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: "Inter", sans-serif;
    }

    .glass {
      background: rgba(18, 2, 36, 0.85);
      backdrop-filter: blur(14px);
      border-radius: 24px;
      border: 1px solid rgba(255, 222, 185, 0.25);
      box-shadow:
        0 18px 40px rgba(0, 0, 0, 0.55),
        0 0 40px rgba(220, 14, 14, 0.4);
    }
  </style>
</head>

<body>

  <div class="glass p-10 w-full max-w-xl shadow-xl">
    <h1 class="text-3xl font-bold text-center text-[#FFDEB9] mb-6 tracking-wide">
      <span id="title-text">File Sharing App</span>
    </h1>

    <!-- Upload Zone -->
    <div id="drop-zone"
         class="border-2 border-dashed border-[#FFDEB9] rounded-2xl p-8 text-center cursor-pointer transition
                hover:bg-white/5 hover:-translate-y-1 hover:shadow-[0_12px_40px_rgba(0,0,0,0.5)]">

      <i data-lucide="upload-cloud" class="w-12 h-12 text-[#FFDEB9] mx-auto mb-3"></i>
      <p class="text-[#FFDEB9] font-semibold text-lg">Drag & Drop or Click to Upload</p>
      <p class="text-[#FFDEB9]/70 text-sm mt-1">Up to 100 MB per file</p>

      <input type="file" id="file-input" class="hidden" />
    </div>

    <!-- Progress Bar -->
    <div id="progress-box" class="hidden mt-6">
      <div class="w-full bg-white/10 rounded-full h-3 overflow-hidden">
        <div id="progress-bar" class="bg-[#DC0E0E] h-3 rounded-full w-0"></div>
      </div>
      <p id="progress-text" class="text-[#FFDEB9] mt-2 text-center text-lg"></p>
    </div>

    <!-- Upload Result -->
    <div id="result-box" class="hidden mt-8 text-center">
      <i data-lucide="check-circle" class="w-12 h-12 text-[#FFDEB9] mx-auto mb-3"></i>
      <p class="text-[#FFDEB9] text-lg mb-3">File Uploaded Successfully!</p>

      <div class="flex flex-col gap-3">

        <div class="flex items-center gap-2 bg-white/10 border border-[#FFDEB9]/40 p-2 rounded-xl">
          <input id="share-link"
                 class="flex-1 bg-transparent text-[#FFDEB9] outline-none text-sm"
                 readonly />
          <button id="copy-btn"
                  class="px-4 py-2 rounded-lg bg-[#DC0E0E] text-white text-sm font-semibold
                         hover:bg-red-700 active:scale-95 transition flex items-center gap-1">
            <i data-lucide="copy" class="w-4 h-4"></i> Copy
          </button>
        </div>

        <button id="open-link-btn"
                class="w-full px-4 py-3 rounded-xl bg-[#FFDEB9] text-[#62109F] font-semibold
                       hover:bg-[#ffe6c7] active:scale-95 transition flex items-center justify-center gap-2">
          <i data-lucide="external-link" class="w-4 h-4"></i>
          Open Link in New Tab
        </button>

      </div>
    </div>

    <!-- Toast -->
    <div id="toast"
         class="hidden fixed bottom-6 right-6 bg-black text-white px-4 py-2 rounded-lg shadow-lg">
      Copied!
    </div>

  </div>

  <script>
    lucide.createIcons();

    const dropZone = document.getElementById("drop-zone");
    const fileInput = document.getElementById("file-input");
    const progressBox = document.getElementById("progress-box");
    const progressBar = document.getElementById("progress-bar");
    const progressText = document.getElementById("progress-text");
    const resultBox = document.getElementById("result-box");
    const shareLink = document.getElementById("share-link");
    const copyBtn = document.getElementById("copy-btn");
    const openLinkBtn = document.getElementById("open-link-btn");
    const toast = document.getElementById("toast");

    gsap.from("#title-text", { opacity: 0, y: -20, duration: 1 });

    dropZone.addEventListener("click", () => fileInput.click());
    dropZone.addEventListener("dragover", (e) => e.preventDefault());
    dropZone.addEventListener("drop", (e) => {
      e.preventDefault();
      fileInput.files = e.dataTransfer.files;
      uploadFile();
    });

    fileInput.addEventListener("change", uploadFile);

    function uploadFile() {
      const file = fileInput.files[0];
      if (!file) return;

      progressBox.classList.remove("hidden");

      const formData = new FormData();
      formData.append("file", file);

      const xhr = new XMLHttpRequest();
      xhr.open("POST", "/uploadfile");

      xhr.upload.onprogress = (e) => {
        let percent = (e.loaded / e.total) * 100;
        progressBar.style.width = percent + "%";
        progressText.textContent = Math.floor(percent) + "%";
      };

      xhr.onload = () => {
        const data = JSON.parse(xhr.responseText);

        const shareUrl =
          window.location.origin +
          `/files/${data.fileId}?url=${encodeURIComponent(data.fileUrl)}`;

        resultBox.classList.remove("hidden");
        shareLink.value = shareUrl;

        openLinkBtn.onclick = () => window.open(shareUrl, "_blank");

        gsap.from("#result-box", { opacity: 0, y: 20, duration: 0.5 });
      };

      xhr.send(formData);
    }

    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText(shareLink.value);
      toast.classList.remove("hidden");
      setTimeout(() => toast.classList.add("hidden"), 1200);
    });
  </script>

</body>
</html>
